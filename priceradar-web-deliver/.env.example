# ─── SUPABASE (banco de dados remoto + autenticacao) ───
# Pegue em: https://supabase.com  ->  Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# ─── RESEND (comunicacao externa por e-mail) ───
# Opcional. Sem isso o alerta funciona em "modo preview" (nao envia e-mail real).
# Pegue em: https://resend.com -> API Keys
RESEND_API_KEY=
ALERT_FROM_EMAIL=PriceRadar AI <onboarding@resend.dev>
